# JasaDigital - Environment Variables
# ======================================

# Port server
PORT=3000

# Mode: production | development
NODE_ENV=development

# Midtrans
# Ambil dari https://dashboard.snap.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# Domain yang diizinkan untuk CORS
ALLOWED_ORIGIN=http://localhost:3000

# WhatsApp bisnis (format internasional tanpa +)
WHATSAPP_NUMBER=6281383048811

# Admin credentials (untuk API, ganti di production)
ADMIN_PASSWORD=admin123

# Telegram bot (opsional untuk notifikasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
