# JasaDigital - Environment Variables
# ======================================

# Database PostgreSQL (GRATIS via Supabase/Neon).
# Jika diisi, order tersimpan aman permanen di database (tidak hilang saat redeploy).
# Jika kosong, server pakai fallback file JSON.
# Contoh URL Supabase: postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port server
PORT=3000

# Mode: production | development
NODE_ENV=development

# Midtrans
# Ambil dari https://dashboard.snap.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# Domain yang diizinkan untuk CORS
ALLOWED_ORIGIN=http://localhost:3000

# WhatsApp bisnis (format internasional tanpa +)
WHATSAPP_NUMBER=6281383048811

# Admin credentials (untuk API, ganti di production)
ADMIN_PASSWORD=Psp130226

# Telegram bot (opsional untuk notifikasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
